{
  "name": "playwright-ecommerce-tests",
  "version": "1.0.0",
  "description": "Playwright test suite for an e-commerce demo site: login, cart, checkout, mobile, known-bug tracking",
  "scripts": {
    "test": "playwright test",
    "test:desktop": "playwright test --project=\"Desktop Chrome\"",
    "test:mobile": "playwright test --project=\"iPhone 15\" --project=\"Android Pixel 7\"",
    "test:headed": "playwright test --project=\"Desktop Chrome\" --headed",
    "report": "playwright show-report"
  },
  "author": "Shahryar Abbas",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.65.1"
  }
}
